{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "FileProcessingService.Worker.Extensions.SerilogCustomTheme::SerilogTheme, FileProcessingService.Worker",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/logs/FileProcessingService/Worker/logs-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "FileProcessingDatabase": ""
  },
  "FileStorage": {
    "UploadDirectory": "C:/temp/FileProcessingService/uploads"
  },
  "CsvOptions": {
    "Separator": ","
  }
}
